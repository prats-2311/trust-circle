{
  "name": "trust-circle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:history": "tsx --env-file=.env.local scripts/seed-demo-history.ts",
    "seed:patterns": "tsx --env-file=.env.local scripts/seed-patterns.ts",
    "eval:live": "tsx --env-file=.env.local scripts/eval-live.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ag-charts-community": "^14.2.0",
    "ag-charts-react": "^14.2.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "msw": "^3.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
