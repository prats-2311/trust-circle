# Copy to .env.local and fill in. Never commit real values.

# PayPal sandbox app credentials (sandbox only; any other PAYPAL_ENV is refused).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Same client id, exposed to the browser for the PayPal button.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Id of the webhook registered on the PayPal sandbox app (used by the webhook route, added in Plan 5).
PAYPAL_WEBHOOK_ID=

# Postgres connection string (docker compose db listens on 5433).
DATABASE_URL=postgres://trustcircle:trustcircle@localhost:5433/trustcircle
# Integration tests only (docker compose db-test listens on 5434).
TEST_DATABASE_URL=postgres://trustcircle:trustcircle@localhost:5434/trustcircle_test

# Groq API key for the scam checks.
GROQ_API_KEY=
# Groq model that judges payments and messages.
GROQ_TEXT_MODEL=
# Groq model that reads screenshots.
GROQ_VISION_MODEL=
# Groq model that screens text for instructions aimed at the AI (optional; this is the default).
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Signs session cookies; at least 32 characters.
SESSION_SECRET=
# Bearer secret for the cron routes; at least 24 characters.
CRON_SECRET=

# Optional. Id of the sandbox webhook registered for /api/paypal/webhook (leave empty to turn webhooks off).
PAYPAL_WEBHOOK_ID=

# Optional. Resend key for alert email (leave empty to send no email).
RESEND_API_KEY=
# Optional. From address for alert email.
ALERT_FROM_EMAIL=Trust Circle <onboarding@resend.dev>

# Optional push alerts. Set all three or none; a bad value turns push off with a warning.
# Public VAPID key, sent to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private VAPID key.
VAPID_PRIVATE_KEY=
# Contact for push services; must start with mailto: or https:
VAPID_SUBJECT=mailto:alerts@trustcircle.example

# Public address of the app, used in links. Falls back to http://localhost:3000 if invalid.
APP_URL=http://localhost:3000

# Optional. Set to 1 to let the daily GitHub Actions job reset the shared demo (added in Plan 5).
DEMO_DAILY_RESET=

# End-to-end tests only: sandbox buyer login for the senior (Margaret).
SANDBOX_SENIOR_EMAIL=
SANDBOX_SENIOR_PASSWORD=
# End-to-end tests only: sandbox account that receives payments (the grandson).
SANDBOX_GRANDSON_EMAIL=
# End-to-end tests only: set to 1 to allow the demo reset against a non-local database.
E2E_ALLOW_RESET=
